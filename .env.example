# Postgres connection strings. On Vercel + Neon these are set automatically
# (DATABASE_URL is pooled; DATABASE_URL_UNPOOLED is direct, used for migrations).
DATABASE_URL="postgresql://wot:wot@localhost:5432/wot?schema=public"
DATABASE_URL_UNPOOLED="postgresql://wot:wot@localhost:5432/wot?schema=public"

# Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_TRUST_HOST=true

# Optional: Google sign-in (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Optional: send magic-link emails via Resend. Without it, links are printed to the server console.
RESEND_API_KEY=""
EMAIL_FROM="Who Ordered The Tax? <tax@example.com>"

# One-click demo accounts (no email). On by default; set to "false" to hide the demo button.
DEMO_ENABLED=""
