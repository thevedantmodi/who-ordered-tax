generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  /// Direct (non-pooled) connection used for migrations. Locally, set it to the same value as DATABASE_URL.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ---------- Auth.js tables ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  emoji         String    @default("🦝")
  accounts      Account[]
  sessions      Session[]
  billsOwned    Bill[]        @relation("BillOwner")
  participants  Participant[]
  groupsCreated Group[]       @relation("GroupCreator")
  memberships   GroupMember[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ---------- Bills ----------

enum BillStatus {
  OPEN
  LOCKED
  SETTLED
}

enum TaxMode {
  AMOUNT
  PERCENT
}

enum TipMode {
  AMOUNT
  PERCENT_PRE_TAX
  PERCENT_POST_TAX
}

enum FeeMode {
  PROPORTIONAL
  EVEN
}

enum UnclaimedPolicy {
  EVEN
  PAYER
}

model Bill {
  id              String          @id @default(cuid())
  /// Creator. Optional because any group member (including guests) can add a bill to a group.
  ownerId         String?
  owner           User?           @relation("BillOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  groupId         String?
  group           Group?          @relation(fields: [groupId], references: [id], onDelete: SetNull)
  title           String
  merchant        String?
  date            DateTime        @default(now())
  shareToken      String          @unique
  status          BillStatus      @default(OPEN)
  taxMode         TaxMode         @default(AMOUNT)
  taxCents        Int             @default(0)
  taxPercent      Float           @default(0)
  tipMode         TipMode         @default(AMOUNT)
  tipCents        Int             @default(0)
  tipPercent      Float           @default(0)
  feesCents       Int             @default(0)
  feeMode         FeeMode         @default(PROPORTIONAL)
  discountCents   Int             @default(0)
  unclaimedPolicy UnclaimedPolicy @default(EVEN)
  items           Item[]
  participants    Participant[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([ownerId])
  @@index([groupId])
}

model Item {
  id         String   @id @default(cuid())
  billId     String
  bill       Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  name       String
  priceCents Int
  position   Int      @default(0)
  claims     Claim[]
  createdAt  DateTime @default(now())

  @@index([billId])
}

model Participant {
  id          String    @id @default(cuid())
  billId      String
  bill        Bill      @relation(fields: [billId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// On group bills, the group member this participant is.
  memberId    String?
  member      GroupMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  displayName String
  emoji       String    @default("🦝")
  isPayer     Boolean   @default(false)
  /// Random secret stored in an httpOnly cookie to identify guests.
  guestSecret String?   @unique
  paidAt      DateTime?
  claims      Claim[]
  createdAt   DateTime  @default(now())

  @@unique([billId, userId])
  @@unique([billId, memberId])
  @@index([billId])
}

model Claim {
  itemId        String
  item          Item        @relation(fields: [itemId], references: [id], onDelete: Cascade)
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  weight        Int         @default(1)

  @@id([itemId, participantId])
}

// ---------- Groups ----------

model Group {
  id            String        @id @default(cuid())
  name          String
  shareToken    String        @unique
  createdById   String?
  createdBy     User?         @relation("GroupCreator", fields: [createdById], references: [id], onDelete: SetNull)
  /// Settle up with the fewest payments (true) or pay back people directly (false).
  simplifyDebts Boolean       @default(true)
  members       GroupMember[]
  bills         Bill[]
  payments      Payment[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model GroupMember {
  id           String        @id @default(cuid())
  groupId      String
  group        Group         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  displayName  String
  /// Random secret stored in an httpOnly cookie to identify guests across the group's bills.
  guestSecret  String?       @unique
  participants Participant[]
  paymentsFrom Payment[]     @relation("PaymentFrom")
  paymentsTo   Payment[]     @relation("PaymentTo")
  createdAt    DateTime      @default(now())

  @@unique([groupId, userId])
  @@index([groupId])
}

model Payment {
  id           String      @id @default(cuid())
  groupId      String
  group        Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  fromMemberId String
  from         GroupMember @relation("PaymentFrom", fields: [fromMemberId], references: [id], onDelete: Cascade)
  toMemberId   String
  to           GroupMember @relation("PaymentTo", fields: [toMemberId], references: [id], onDelete: Cascade)
  amountCents  Int
  note         String?
  createdAt    DateTime    @default(now())

  @@index([groupId])
}
